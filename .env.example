# Copia este archivo como .env (git lo ignora) y pon tu clave de GroqCloud.
# docker compose lo lee solo; para "sh ./mvnw spring-boot:run" exporta la variable en la terminal.
GROQ_API_KEY=
# Opcional: tokens de toda la app en 24 h (el plan gratis de Groq da 200K por dia para qwen/qwen3.8-27b).
# El plan gratis tambien limita a 1.000 tokens de salida por minuto: no subas LOCOMOTORA_AI_*_MAX_TOKENS sin mejorar el plan.
LOCOMOTORA_AI_DAILY_TOKEN_BUDGET=150000
